---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Checkout Seguro">
	<Header />

	<main class="checkout-page container">
		<header class="checkout-header gsap-reveal">
			<h1>Finalizar Compra</h1>
			<div class="progress-bar">
				<div class="step active">1. Identificação</div>
				<div class="step">2. Entrega</div>
				<div class="step">3. Pagamento</div>
			</div>
		</header>

		<div class="checkout-grid">
			<div class="checkout-form gsap-reveal">
				<section class="form-section">
					<h3>Informações de Contato</h3>
					<div class="input-group">
						<input type="email" placeholder="E-mail" required />
					</div>
					<div class="guest-checkout">
						<label><input type="checkbox" checked /> Continuar como convidado</label>
					</div>
				</section>

				<section class="form-section">
					<h3>Endereço de Entrega</h3>
					<div class="input-grid">
						<input type="text" placeholder="CEP" class="full" />
						<input type="text" placeholder="Endereço" class="full" />
						<input type="text" placeholder="Número" />
						<input type="text" placeholder="Complemento" />
						<input type="text" placeholder="Cidade" class="full" />
					</div>
				</section>

				<section class="form-section">
					<h3>Pagamento</h3>
					<div class="payment-methods">
						<div class="method active" data-method="pix">
							<span>PIX</span>
							<span class="discount">5% OFF</span>
						</div>
						<div class="method" data-method="card">
							<span>Cartão de Crédito</span>
						</div>
						<div class="method">
							<span>Boleto</span>
						</div>
					</div>
					<div id="pix-details" class="payment-details">
						<p>Escaneie o QR Code abaixo ou copie a chave Pix:</p>
						<div class="qr-placeholder">
							<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=lumia-ohana-pix-mock" alt="Pix QR" />
						</div>
						<code class="pix-key">00020126360014BR.GOV.BCB.PIX0114+5511999999999</code>
						<button class="copy-btn">Copiar Chave Pix</button>
					</div>
				</section>

				<button class="btn-gold checkout-btn">Confirmar Pedido</button>
			</div>

			<aside class="order-summary gsap-reveal">
				<div class="summary-card">
					<h3>Resumo do Pedido</h3>
					<div id="checkout-items" class="summary-items">
						<!-- Items injected by script -->
					</div>
					<div class="totals">
						<div class="row">
							<span>Subtotal</span>
							<span id="subtotal">R$ 0,00</span>
						</div>
						<div class="row">
							<span>Frete</span>
							<span class="free">Grátis</span>
						</div>
						<div class="row total">
							<span>Total</span>
							<span id="total">R$ 0,00</span>
						</div>
					</div>
					<div class="security-badges">
						<img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/SSL_secured_logo.png" alt="SSL" />
						<p>Compra 100% segura</p>
					</div>
				</div>
			</aside>
		</div>
	</main>

	<script>
		import { getCart } from '../utils/cart.js';

		const itemsContainer = document.getElementById('checkout-items');
		const subtotalEl = document.getElementById('subtotal');
		const totalEl = document.getElementById('total');

		function renderItems() {
			const cart = getCart();
			if (itemsContainer) {
				itemsContainer.innerHTML = cart.map(item => `
					<div class="item">
						<img src="${item.image}" alt="${item.name}" />
						<div class="info">
							<p class="name">${item.name}</p>
							<p class="qty">Qtd: ${item.quantity}</p>
						</div>
						<span class="price">${item.price}</span>
					</div>
				`).join('');

				const subtotal = cart.reduce((acc, item) => {
					const price = parseFloat(item.price.replace('R$ ', '').replace(',', '.'));
					return acc + (price * item.quantity);
				}, 0);

				const subtotalStr = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
				if (subtotalEl) subtotalEl.innerText = subtotalStr;
				if (totalEl) totalEl.innerText = subtotalStr;
			}
		}

		renderItems();
	</script>

	<style is:global>
		.payment-details {
			margin-top: 2rem;
			padding: 1.5rem;
			background: #f9f9f9;
			border-radius: 10px;
			text-align: center;
			display: none;
		}
		.payment-methods .method.active[data-method="pix"] ~ #pix-details {
			display: block;
		}
		.qr-placeholder {
			margin: 1rem 0;
		}
		.pix-key {
			display: block;
			background: #eee;
			padding: 0.8rem;
			font-size: 0.8rem;
			border-radius: 5px;
			word-break: break-all;
			margin-bottom: 1rem;
		}
		.copy-btn {
			background: var(--color-gold);
			color: white;
			border: none;
			padding: 0.5rem 1rem;
			border-radius: 5px;
			cursor: pointer;
		}
	</style>

<style>
	.checkout-page {
		padding-top: 150px;
		padding-bottom: 8rem;
	}

	.checkout-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.checkout-header h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
	}

	.progress-bar {
		display: flex;
		justify-content: center;
		gap: 3rem;
	}

	.step {
		font-size: 0.9rem;
		color: #999;
		position: relative;
	}

	.step.active {
		color: var(--color-accent-pink);
		font-weight: 700;
		border-bottom: 2px solid var(--color-accent-pink);
	}

	.checkout-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 5rem;
	}

	.form-section {
		background: #fff;
		padding: 2.5rem;
		border: 1px solid #eee;
		border-radius: 15px;
		margin-bottom: 2rem;
	}

	.form-section h3 {
		margin-bottom: 1.5rem;
		font-size: 1.2rem;
	}

	.input-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.full {
		grid-column: span 2;
	}

	input[type="text"], input[type="email"] {
		padding: 1rem;
		border: 1px solid #ddd;
		border-radius: 8px;
		width: 100%;
	}

	.payment-methods {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.method {
		padding: 1rem;
		border: 2px solid #eee;
		border-radius: 10px;
		text-align: center;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.method.active {
		border-color: var(--color-gold);
		background: #fff9e6;
	}

	.discount {
		color: #27ae60;
		font-size: 0.7rem;
	}

	.checkout-btn {
		width: 100%;
		padding: 1.5rem;
		font-size: 1.1rem;
	}

	.summary-card {
		background: #fdf2f8;
		padding: 2.5rem;
		border-radius: 20px;
		position: sticky;
		top: 100px;
	}

	.summary-card h3 {
		margin-bottom: 2rem;
	}

	.item {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.item img {
		width: 60px;
		height: 60px;
		border-radius: 8px;
		object-fit: cover;
	}

	.item .info {
		flex: 1;
	}

	.item .name {
		font-weight: 700;
		font-size: 0.9rem;
	}

	.item .qty {
		font-size: 0.8rem;
		color: #666;
	}

	.totals {
		border-top: 1px solid #ddd;
		padding-top: 1.5rem;
	}

	.row {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.8rem;
	}

	.total {
		font-size: 1.4rem;
		font-weight: 700;
		margin-top: 1.5rem;
		color: var(--color-charcoal);
	}

	.free {
		color: #27ae60;
		font-weight: 700;
	}

	.security-badges {
		margin-top: 3rem;
		text-align: center;
	}

	.security-badges img {
		height: 40px;
		margin-bottom: 0.5rem;
	}

	.security-badges p {
		font-size: 0.8rem;
		color: #888;
	}

	@media (max-width: 1024px) {
		.checkout-grid {
			grid-template-columns: 1fr;
		}
		.order-summary {
			order: -1;
		}
	}
</style>
