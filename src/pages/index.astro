---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';

const featuredProducts = [
	{ id: 'serum-iluminador-gold', name: 'Sérum Iluminador Gold', price: 'R$ 189,90', category: 'Skincare', image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=1974&auto=format&fit=crop' },
	{ id: 'batom-matte-velvet-pink', name: 'Batom Matte Velvet Pink', price: 'R$ 89,90', category: 'Maquiagem', image: 'https://images.unsplash.com/photo-1586776977607-310e9c725c37?q=80&w=1960&auto=format&fit=crop' },
	{ id: 'creme-hidratante-ohana', name: 'Creme Hidratante Ohana', price: 'R$ 149,90', category: 'Skincare', image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=1974&auto=format&fit=crop' },
	{ id: 'mascara-facial-argila-rosa', name: 'Máscara Facial Argila Rosa', price: 'R$ 119,90', category: 'Skincare', image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=2070&auto=format&fit=crop' },
];
---

<BaseLayout title="Lorem Ipsum">
	<Header />
	
	<main>
		<Hero />

		<section class="featured container">
			<div class="section-header gsap-reveal">
				<h2>Lorem Ipsum</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
			</div>
			<div class="product-grid">
				{featuredProducts.map(product => (
					<ProductCard {...product} />
				))}
			</div>
		</section>

		<section class="benefits">
			<div class="container benefit-grid">
				<div class="benefit-item gsap-reveal">
					<div class="icon">✨</div>
					<h3>Lorem Ipsum</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				</div>
				<div class="benefit-item gsap-reveal">
					<div class="icon">🌿</div>
					<h3>Lorem Ipsum</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				</div>
				<div class="benefit-item gsap-reveal">
					<div class="icon">🚚</div>
					<h3>Lorem Ipsum</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				</div>
			</div>
		</section>

		<section class="social-proof container">
			<div class="section-header gsap-reveal">
				<h2>Lorem Ipsum</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
			</div>
			<div class="testimonial-slider gsap-reveal">
				<div class="testimonial-card">
					<div class="stars">⭐⭐⭐⭐⭐</div>
					<p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."</p>
					<span class="author">— Lorem I.</span>
				</div>
				<div class="testimonial-card">
					<div class="stars">⭐⭐⭐⭐⭐</div>
					<p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."</p>
					<span class="author">— Lorem J.</span>
				</div>
			</div>
		</section>

		<section class="cta-section">
			<div class="container gsap-reveal">
				<h2>Junte-se ao Universo Lumiá</h2>
				<p>Receba novidades, dicas de beleza e ofertas exclusivas.</p>
				<form class="newsletter-form">
					<input type="email" placeholder="Seu melhor e-mail" required />
					<button type="submit" class="btn-gold">Assinar</button>
				</form>
			</div>
		</section>
	</main>

	<footer class="main-footer">
		<div class="container">
			<div class="footer-content">
				<div class="footer-brand">
					<h3>LUMIÁ OHANA</h3>
					<p>Beleza consciente, naturalmente você.</p>
				</div>
				<div class="footer-links">
					<h4>Institucional</h4>
					<ul>
						<li><a href="/sobre">Quem Somos</a></li>
						<li><a href="/privacidade">Política de Privacidade</a></li>
						<li><a href="/termos">Termos de Uso</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>Ajuda</h4>
					<ul>
						<li><a href="/contato">Contato</a></li>
						<li><a href="/faq">FAQ</a></li>
						<li><a href="/trocas">Trocas e Devoluções</a></li>
					</ul>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; 2026 Lumiá OHANA. Todos os direitos reservados.</p>
			</div>
		</div>
	</footer>
</BaseLayout>

<style>
	main {
		margin-bottom: 5rem;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
		padding-top: 5rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2.5rem;
	}

	.benefits {
		padding: 8rem 0;
		background-color: var(--color-accent-pink);
		color: white;
	}

	.benefits h2, .benefits p {
		color: white;
	}

	.benefit-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 3rem;
		margin-top: 4rem;
	}

	.benefit-card {
		padding: 3rem;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(5px);
		border-radius: 20px;
		text-align: center;
		border: 1px solid rgba(255, 255, 255, 0.2);
		transition: transform 0.3s ease;
	}

	.benefit-card:hover {
		transform: translateY(-10px);
		background: rgba(255, 255, 255, 0.15);
	}

	.benefit-card h3 {
		color: white;
		margin-bottom: 1rem;
		font-size: 1.5rem;
	}

	.benefit-card p {
		color: rgba(255, 255, 255, 0.9);
	}

	.social-proof {
		padding: 5rem 0;
	}

	.testimonial-slider {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.testimonial-card {
		background: var(--color-primary-pink);
		padding: 3rem;
		border-radius: 20px;
		text-align: center;
		border: 1px solid var(--color-accent-pink);
	}

	.stars {
		margin-bottom: 1.5rem;
		color: var(--color-gold);
	}

	.testimonial-card p {
		font-style: italic;
		font-size: 1.1rem;
		margin-bottom: 1.5rem;
	}

	.author {
		font-weight: 700;
		color: var(--color-gold);
	}

	.cta-section {
		background: var(--color-charcoal);
		color: white;
		padding: 8rem 0;
		text-align: center;
	}

	.cta-section h2 {
		color: white;
		font-size: 3rem;
		margin-bottom: 1.5rem;
	}

	.newsletter-form {
		margin-top: 3rem;
		display: flex;
		justify-content: center;
		gap: 1rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.newsletter-form input {
		padding: 1rem 2rem;
		border-radius: 50px;
		border: 1px solid rgba(255,255,255,0.2);
		background: rgba(255,255,255,0.1);
		color: white;
		flex: 1;
	}

	.main-footer {
		background: #fafafa;
		padding: 5rem 0 2rem;
		border-top: 4px solid var(--color-accent-pink);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 4rem;
		margin-bottom: 4rem;
	}

	.footer-brand h3 {
		margin-bottom: 1rem;
		letter-spacing: 2px;
	}

	.footer-links h4 {
		margin-bottom: 1.5rem;
		font-size: 1rem;
		text-transform: uppercase;
	}

	.footer-links ul li {
		margin-bottom: 0.8rem;
	}

	.footer-bottom {
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid #eee;
		font-size: 0.8rem;
		color: #999;
	}

	@media (max-width: 768px) {
		.testimonial-slider {
			grid-template-columns: 1fr;
		}
		.footer-content {
			grid-template-columns: 1fr;
		}
		.newsletter-form {
			flex-direction: column;
		}
	}
</style>
