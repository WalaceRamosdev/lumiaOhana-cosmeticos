---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard Admin">
	<div class="admin-layout">
		<aside class="sidebar" id="sidebar">
			<div class="sidebar-header">
				<div class="logo">LUMIÁ <span>OHANA</span></div>
				<button class="close-sidebar" id="close-sidebar">&times;</button>
			</div>
			<nav>
				<a href="/admin" class="active">Dashboard</a>
				<a href="#">Produtos</a>
				<a href="#">Vendas</a>
				<a href="#">Clientes</a>
				<button id="logout-btn">Sair</button>
			</nav>
		</aside>

		<main class="admin-main">
			<header class="admin-header">
				<div class="header-left">
					<button class="menu-toggle" id="menu-toggle">☰</button>
					<h1>Dashboard</h1>
				</div>
				<div class="user-info">Administrador</div>
			</header>

			<div class="stats-grid gsap-reveal">
				<div class="stat-card">
					<h3>Ganhos do Mês</h3>
					<p class="value">R$ 12.450,00</p>
					<span class="trend">+15% vs mês anterior</span>
				</div>
				<div class="stat-card">
					<h3>Pedidos</h3>
					<p class="value">84</p>
					<span class="trend">+8% vs mês anterior</span>
				</div>
				<div class="stat-card">
					<h3>Visitantes</h3>
					<p class="value">2.100</p>
					<span class="trend">+22% vs mês anterior</span>
				</div>
			</div>

			<section class="admin-section gsap-reveal">
				<div class="section-header">
					<h2>Controle de Estoque</h2>
					<button class="btn-gold small">Adicionar Produto</button>
				</div>
				<div class="table-container">
					<table>
						<thead>
							<tr>
								<th>Produto</th>
								<th>Categoria</th>
								<th>Preço</th>
								<th>Estoque</th>
								<th>Status</th>
								<th>Ações</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Lorem Ipsum Gold</td>
								<td>Skincare</td>
								<td>R$ 189,90</td>
								<td>24</td>
								<td><span class="badge in-stock">Em estoque</span></td>
								<td><button class="edit-btn">Editar</button></td>
							</tr>
							<tr>
								<td>Lorem Ipsum Velvet</td>
								<td>Maquiagem</td>
								<td>R$ 89,90</td>
								<td>5</td>
								<td><span class="badge low-stock">Baixo estoque</span></td>
								<td><button class="edit-btn">Editar</button></td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section class="admin-section gsap-reveal">
				<h2>Desempenho Mensal (Em Construção)</h2>
				<div class="chart-placeholder">
					<div class="chart-bar" style="height: 40%"><span>Jan</span></div>
					<div class="chart-bar" style="height: 60%"><span>Fev</span></div>
					<div class="chart-bar" style="height: 80%"><span>Mar</span></div>
					<div class="chart-bar" style="height: 70%"><span>Abr</span></div>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<script>
	// Simple auth check
	if (localStorage.getItem('lumia_admin_auth') !== 'true') {
		window.location.href = '/admin/login';
	}

	document.getElementById('logout-btn')?.addEventListener('click', () => {
		localStorage.removeItem('lumia_admin_auth');
		window.location.href = '/admin/login';
	});

	// Mobile Sidebar Toggle
	const sidebar = document.getElementById('sidebar');
	const menuToggle = document.getElementById('menu-toggle');
	const closeSidebar = document.getElementById('close-sidebar');

	menuToggle?.addEventListener('click', () => {
		sidebar?.classList.add('open');
	});

	closeSidebar?.addEventListener('click', () => {
		sidebar?.classList.remove('open');
	});
</script>

<style>
	.admin-layout {
		display: grid;
		grid-template-columns: 280px 1fr;
		min-height: 100vh;
	}

	@media (max-width: 1024px) {
		.admin-layout {
			grid-template-columns: 1fr;
		}
	}

	.sidebar {
		background: var(--color-charcoal);
		color: white;
		padding: 2rem;
		transition: transform 0.3s ease;
	}

	@media (max-width: 1024px) {
		.sidebar {
			position: fixed;
			top: 0;
			left: 0;
			height: 100vh;
			width: 280px;
			z-index: 2000;
			transform: translateX(-100%);
		}
		.sidebar.open {
			transform: translateX(0);
		}
	}

	.sidebar-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
	}

	.close-sidebar {
		display: none;
		background: none;
		border: none;
		color: white;
		font-size: 2rem;
		cursor: pointer;
	}

	@media (max-width: 1024px) {
		.close-sidebar {
			display: block;
		}
	}

	.sidebar .logo {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		letter-spacing: 2px;
		margin-bottom: 3rem;
	}

	.sidebar nav {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sidebar a {
		padding: 1rem;
		border-radius: 8px;
		color: rgba(255,255,255,0.7);
	}

	.sidebar a.active {
		background: rgba(255,255,255,0.1);
		color: white;
		font-weight: 700;
	}

	#logout-btn {
		margin-top: 4rem;
		background: none;
		border: 1px solid rgba(255,255,255,0.2);
		color: white;
		padding: 0.8rem;
		border-radius: 8px;
		cursor: pointer;
	}

	.admin-main {
		background: #f8f9fa;
		padding: 3rem;
	}

	@media (max-width: 768px) {
		.admin-main {
			padding: 1.5rem;
		}
	}

	.menu-toggle {
		display: none;
		background: none;
		border: none;
		font-size: 1.5rem;
		cursor: pointer;
		color: var(--color-charcoal);
	}

	@media (max-width: 1024px) {
		.menu-toggle {
			display: block;
		}
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.admin-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-bottom: 3rem;
	}

	@media (max-width: 768px) {
		.stats-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	.stat-card {
		background: white;
		padding: 2rem;
		border-radius: 15px;
		box-shadow: 0 4px 6px rgba(0,0,0,0.02);
	}

	.stat-card h3 {
		font-size: 0.9rem;
		color: #888;
		margin-bottom: 1rem;
	}

	.stat-card .value {
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-charcoal);
	}

	.trend {
		font-size: 0.8rem;
		color: #27ae60;
		font-weight: 700;
	}

	.admin-section {
		background: white;
		padding: 2rem;
		border-radius: 15px;
		margin-bottom: 3rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}

	.table-container {
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		min-width: 800px; /* Force scroll on mobile */
	}

	th {
		text-align: left;
		padding: 1rem;
		border-bottom: 2px solid #eee;
		color: #888;
		font-size: 0.9rem;
	}

	td {
		padding: 1rem;
		border-bottom: 1px solid #eee;
		font-size: 0.9rem;
	}

	.badge {
		padding: 0.3rem 0.6rem;
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 700;
	}

	.in-stock { background: #e8f5e9; color: #2e7d32; }
	.low-stock { background: #fff3e0; color: #ef6c00; }

	.edit-btn {
		background: none;
		border: 1px solid #ddd;
		padding: 0.4rem 0.8rem;
		border-radius: 5px;
		cursor: pointer;
	}

	.chart-placeholder {
		height: 200px;
		display: flex;
		align-items: flex-end;
		gap: 2rem;
		padding: 2rem;
		background: #fafafa;
		border-radius: 10px;
		margin-top: 2rem;
	}

	.chart-bar {
		flex: 1;
		background: var(--color-gold);
		border-radius: 5px 5px 0 0;
		position: relative;
		min-width: 40px;
	}

	.chart-bar span {
		position: absolute;
		bottom: -25px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 0.8rem;
		color: #888;
	}
</style>
